@PACKAGE_INIT@

# libpegConfig.cmake - find_package(libpeg) support.
#
# The imported target is peg::peg, the same name the in-tree ALIAS carries,
# so a consumer's target_link_libraries line does not change between the
# two ways of using the library.

include("${CMAKE_CURRENT_LIST_DIR}/libpegTargets.cmake")

check_required_components(libpeg)
